# Public browser configuration. Copy to .env.local for local production-mode testing.
VITE_APP_NAME=WashRadar
VITE_DEMO_MODE=true
VITE_BASE_PATH=/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_SUPPORT_EMAIL=support@washradar.ca
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_SENTRY_DSN=

# Server-side values belong in Supabase Edge Function secrets, never VITE_* or GitHub Pages.
# GOOGLE_MAPS_SERVER_KEY=
# GOOGLE_ROUTES_DAILY_LIMIT=300
# SUPABASE_SERVICE_ROLE_KEY=provided automatically to hosted Supabase Edge Functions
# ADMIN_EMAILS=owner@example.com
