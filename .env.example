# Public browser configuration. Copy to .env.local for local production-mode testing.
VITE_APP_NAME=WashRadar
VITE_DEMO_MODE=true
VITE_BASE_PATH=/
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_SUPPORT_EMAIL=support@washradar.ca
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Leave blank on the web so the index is loaded from the current site.
# Native/Capacitor builds should point at the same remotely hosted static ODA index,
# e.g. https://washradar.ca/address-index/ so address data is not bundled into the app.
VITE_ADDRESS_INDEX_BASE=
VITE_SENTRY_DSN=

# Queue refresh strategy.
# poll is the production-safe default: visible tabs fetch only current queue signals
# every ~20s and do not hold a Supabase Realtime connection per browser.
# realtime can be enabled for smaller experiments without changing application code.
VITE_QUEUE_REFRESH_MODE=poll
VITE_QUEUE_POLL_MS=20000

# Server-side values belong in Supabase Edge Function secrets, never VITE_* or GitHub Pages.
# GOOGLE_MAPS_SERVER_KEY=
# GOOGLE_ROUTES_DAILY_LIMIT=300
# SUPABASE_SERVICE_ROLE_KEY=provided automatically to hosted Supabase Edge Functions
# ADMIN_EMAILS=owner@example.com
